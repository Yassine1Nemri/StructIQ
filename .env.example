# Copy to .env, then run make secrets. Never commit .env.
POSTGRES_DB=structiq
POSTGRES_USER=structiq
POSTGRES_PASSWORD=replace-with-generated-password
JWT_SECRET=replace-with-generated-jwt-secret
INTERNAL_AI_SHARED_SECRET=replace-with-generated-internal-secret
# Demo credentials are generated by make seed, separately from this file.
# Set AI_PROVIDER=ollama to use local Qwen without an API key.
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Gemini is optional. With AI_PROVIDER=gemini and no key, core flows still work.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
FRONTEND_ORIGIN=http://localhost:5173
# Maximum bytes per upload, configurable from 1 through 10485760 (10 MiB).
UPLOAD_MAX_BYTES=10485760
